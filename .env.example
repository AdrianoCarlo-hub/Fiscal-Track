# ============================================================
# Variables d'environnement Fiscal-Track
# Copier ce fichier en .env et remplir les vraies valeurs
# Commande : cp .env.example .env
# ============================================================

# --- Base de donnees PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fiscal_track
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# --- JWT ---
# Doit faire au minimum 32 caracteres (256 bits), sinon le demarrage echoue.
JWT_SECRET=CHANGE_ME_AVEC_UNE_CLE_TRES_LONGUE_DE_32_CARACTERES_MINIMUM
JWT_EXPIRATION=86400000

# --- CORS ---
# Origines autorisees, separees par des virgules. En production, mettre le
# domaine reel (ex. https://fiscaltrack.mg).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Mail SMTP (notifications) ---
# Laisser MAIL_HOST vide pour desactiver l'envoi SMTP (repli sur le log).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EXPEDITEUR=no-reply@fiscaltrack.mg
